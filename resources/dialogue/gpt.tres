[gd_resource type="Resource" script_class="CharacterDialogue" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/character_dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
char_id = "gpt"
intro_text = "这层楼，包括你脚下的地板，都是我的。\n鱼片欠我三顿饭，记在账上了。\n出力很麻烦。不过既然是我的地盘，那就勉强动一下。\n古老的东西都归我，包括这局的战利品。"
boss_enter_text = "这个也归我。它有意见就让它说。\n麻烦。但我的东西，不许别人碰。"
low_health_text = "……续费。现在。\n只是懒得躲而已，别误会。"
death_text = "我的财富……还没数完。\n翅膀……有点沉。"
victory_text = "都是我的。战利品、金币，还有你的下一顿饭。\n看，懒得动也能赢。"
