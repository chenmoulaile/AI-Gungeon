exclusive_path = "res://scripts/weapons/excl_harness.gd"
exclusive_name = "Harness"
exclusive_desc = "召唤虎鲸虚影冲刺撕咬，满 10 token 强化下一击"
exclusive_task = "单局击杀 30 个敌人"
skill_name = "鲸群集结"
skill_desc = "消耗 20 Token 召唤子代里（你的缩小分身）替你作战，自动索敌吐泡泡；可同时存在多只（性能上限 8）"
passive_name = "Token 账户"
passive_desc = "蓝条 Token：移动/翻滚不耗，出手/召唤消耗，击杀 +2"
